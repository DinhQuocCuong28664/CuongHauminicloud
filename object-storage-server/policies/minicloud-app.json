{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AvatarReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::profile-pics/*"]
    },
    {
      "Sid": "DocumentsReadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::documents/*"]
    },
    {
      "Sid": "ListOwnBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::profile-pics", "arn:aws:s3:::documents"]
    }
  ]
}
