{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupWriteAndRestoreRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::db-backups/*"]
    },
    {
      "Sid": "ListBackups",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetLifecycleConfiguration"],
      "Resource": ["arn:aws:s3:::db-backups"]
    }
  ]
}
