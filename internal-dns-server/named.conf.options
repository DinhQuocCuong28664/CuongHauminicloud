// Answer and recurse only for hosts in cloud-net (and the container itself),
// so it never becomes an open resolver on EC2
acl cloudnet {
    10.10.10.0/24;
    127.0.0.1;
};

options {
    directory "/var/cache/bind";

    listen-on { any; };
    listen-on-v6 { none; };

    allow-query { cloudnet; };
    recursion yes;
    allow-recursion { cloudnet; };

    // Names outside the cloud.local zone are forwarded to public DNS
    forwarders { 8.8.8.8; 1.1.1.1; };
    dnssec-validation auto;
};
