# HTTPS server on EC2, mounted by docker-compose.ec2.yml in place of conf.d/default.conf.
# The nginx image runs envsubst on /etc/nginx/templates/*.template at startup: ${PUBLIC_DOMAIN} becomes
# the <dashed-ip>.sslip.io domain; nginx variables ($host...) stay as they are, they are not environment variables.

# Port 80: serve only the Let's Encrypt challenge, redirect everything else to HTTPS
server {
    listen 80;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # The Docker healthcheck calls http://127.0.0.1/healthz, no redirect
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Redirect to the domain that has the certificate (even when the user typed the IP address)
    location / {
        return 301 https://${PUBLIC_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_DOMAIN};

    # Let's Encrypt certificate obtained by the certbot job (certbot-conf volume)
    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Applies to locations without their own add_header (for example the Keycloak /auth/)
    add_header Strict-Transport-Security $hsts_header always;

    include /etc/nginx/snippets/routes.conf;
}
