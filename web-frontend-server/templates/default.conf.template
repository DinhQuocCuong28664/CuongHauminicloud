server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # ${SERVER_NAME} được thay lúc khởi động (web1 hoặc web2)
    add_header X-Served-By ${SERVER_NAME} always;

    location / {
        try_files $uri $uri/ =404;
    }

    # alias phải có dấu / ở cuối, khớp với location /blog/
    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }

    # Số liệu kết nối cho nginx-prometheus-exporter; chỉ exporter trong cloud-net được đọc
    location = /nginx_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        allow 10.10.10.62;
        deny all;
    }
}
