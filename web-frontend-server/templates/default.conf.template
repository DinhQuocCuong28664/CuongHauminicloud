server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # ${SERVER_NAME} được thay lúc khởi động (web1 hoặc web2)
    add_header X-Served-By ${SERVER_NAME} always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Nâng cao A01: Portal (ứng dụng một trang). CSP chỉ cho tải script, style, ảnh, request từ chính origin;
    # add_header trong location thay thế header kế thừa nên khai báo lại X-Served-By
    location ^~ /portal/ {
        try_files $uri /portal/index.html;
        add_header X-Served-By ${SERVER_NAME} always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
        add_header Cache-Control "no-cache" always;
    }

    # alias phải có dấu / ở cuối, khớp với location /blog/
    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }

    # Số liệu kết nối cho nginx-prometheus-exporter; chỉ exporter trong cloud-net được đọc
    location = /nginx_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        allow 10.10.10.62;
        deny all;
    }
}
