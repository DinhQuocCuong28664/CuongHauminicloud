{
  "realm": "${KC_REALM}",
  "displayName": "MyMiniCloud – 523H0008 & 523H0025",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "users": [
    {
      "username": "sv01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Quốc Cường",
      "lastName": "Đinh",
      "email": "sv01@cloud.local",
      "credentials": [
        {
          "type": "password",
          "value": "${SV_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor",
        "viewer"
      ]
    },
    {
      "username": "sv02",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Cao Hậu",
      "lastName": "Nguyễn",
      "email": "sv02@cloud.local",
      "credentials": [
        {
          "type": "password",
          "value": "${SV_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "flask-app",
      "name": "MyMiniCloud Flask App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://${PUBLIC_HOST}/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-flask-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "flask-app",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal",
      "name": "MyMiniCloud Portal",
      "description": "Trang web một trang (SPA) đăng nhập bằng Authorization Code + PKCE, gọi API flask-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/portal/*",
        "http://${PUBLIC_HOST}/portal/*",
        "https://${PUBLIC_DOMAIN}/portal/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/portal/*##http://${PUBLIC_HOST}/portal/*##https://${PUBLIC_DOMAIN}/portal/*"
      },
      "protocolMappers": [
        {
          "name": "audience-flask-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "flask-app",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "editor",
        "description": "Được thêm, sửa, xoá sinh viên, tải tài liệu private và xem cảnh báo vận hành"
      },
      {
        "name": "viewer",
        "description": "Chỉ được xem dữ liệu"
      }
    ]
  }
}
