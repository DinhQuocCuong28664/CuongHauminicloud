# Sao chép thành .env rồi đổi mật khẩu. .env không được commit.

# ---------- Docker Hub / image ----------
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=2.0

# Tên máy dùng để truy cập từ bên ngoài: localhost khi chạy local, public IP khi chạy trên EC2
PUBLIC_HOST=localhost
# Tên miền HTTPS: localhost khi chạy local; trên EC2 deploy.sh đặt <ip-dạng-gạch>.sslip.io
PUBLIC_DOMAIN=localhost

# ---------- Cổng trên máy host (theo "Cổng dùng trong lab" của đề) ----------
PROXY_PORT=80
WEB1_PORT=8080
WEB2_PORT=8088
APP_PORT=8085
AUTH_PORT=8081
DB_PORT=3306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DNS_PORT=1053
PROM_PORT=9090
NODE_EXPORTER_PORT=9100
GRAFANA_PORT=3000

# ---------- Database (MariaDB) ----------
DB_ROOT_PASSWORD=change-me
DB_APP_USER=minicloud_app
DB_APP_PASSWORD=change-me
# Nâng cao A09: user chỉ dùng cho job sao lưu
DB_BACKUP_USER=minicloud_backup
DB_BACKUP_PASSWORD=change-me

# ---------- Keycloak ----------
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me
KC_REALM=realm_523H0008_523H0025
OIDC_CLIENT_ID=flask-app
# Mật khẩu của user sv01, sv02 trong realm
SV_PASSWORD=change-me

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Nâng cao: user MinIO quyền tối thiểu (policy trong object-storage-server/policies/)
MINIO_APP_USER=minicloud-app
MINIO_APP_PASSWORD=change-me-at-least-8-chars
MINIO_BACKUP_USER=minicloud-backup
MINIO_BACKUP_PASSWORD=change-me-at-least-8-chars

# ---------- Grafana ----------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# ---------- Cảnh báo (Alertmanager -> webhook /alerts của app) ----------
ALERTMANAGER_PORT=9093
# Chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(24))"
ALERT_WEBHOOK_TOKEN=change-me
