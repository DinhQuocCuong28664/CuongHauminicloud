# Copy to .env and change the passwords. .env must not be committed.

# ---------- Docker Hub / image ----------
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=2.2

# Host name used for outside access: localhost when running locally, the public IP on EC2
PUBLIC_HOST=localhost
# HTTPS domain: localhost when running locally; on EC2 deploy.sh sets <dashed-ip>.sslip.io
PUBLIC_DOMAIN=localhost

# ---------- Host ports (per the "lab ports" table of the assignment) ----------
PROXY_PORT=80
WEB1_PORT=8080
WEB2_PORT=8088
APP_PORT=8085
AUTH_PORT=8081
DB_PORT=3306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DNS_PORT=1053
PROM_PORT=9090
NODE_EXPORTER_PORT=9100
GRAFANA_PORT=3000

# ---------- Database (MariaDB) ----------
DB_ROOT_PASSWORD=change-me
DB_APP_USER=minicloud_app
DB_APP_PASSWORD=change-me
# Advanced A09: user for the backup job only
DB_BACKUP_USER=minicloud_backup
DB_BACKUP_PASSWORD=change-me

# ---------- Keycloak ----------
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me
KC_REALM=realm_523H0008_523H0025
OIDC_CLIENT_ID=flask-app
# Password of the realm users sv01, sv02
SV_PASSWORD=change-me

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Advanced: least-privilege MinIO users (policies in object-storage-server/policies/)
MINIO_APP_USER=minicloud-app
MINIO_APP_PASSWORD=change-me-at-least-8-chars
MINIO_BACKUP_USER=minicloud-backup
MINIO_BACKUP_PASSWORD=change-me-at-least-8-chars

# ---------- Grafana ----------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# ---------- Alerting (Alertmanager -> app /alerts webhook) ----------
ALERTMANAGER_PORT=9093
# Long random string, e.g.: python -c "import secrets; print(secrets.token_hex(24))"
ALERT_WEBHOOK_TOKEN=change-me
