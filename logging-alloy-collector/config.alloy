// Grafana Alloy: reads stdout/stderr of every project container through the Docker API and pushes it to Loki.
// Like the CloudWatch agent / Fluent Bit: applications only need to log to stdout.

discovery.docker "minicloud" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"

  // Only MyMiniCloud containers; skip containers of other projects on the same host
  filter {
    name   = "label"
    values = ["com.docker.compose.project=cuonghauminicloud"]
  }
}

// Low-cardinality labels (container, service) for fast filtering; request_id, status... stay in the JSON log body
discovery.relabel "minicloud" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "minicloud" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.minicloud.targets
  labels           = {"project" = "myminicloud"}
  relabel_rules    = discovery.relabel.minicloud.rules
  refresh_interval = "10s"
  forward_to       = [loki.process.minicloud.receiver]
}

// JSON logs of the proxy and app: use the log level as the "level" label (low cardinality), keep the line as is
loki.process "minicloud" {
  stage.match {
    selector = "{service=~\"api-gateway-proxy-server|application-backend-server\"}"

    stage.json {
      expressions = {level = "level", status = "status"}
    }

    stage.template {
      source   = "level"
      template = "{{ if .level }}{{ .level }}{{ else if .status }}{{ if ge (atoi .status) 500 }}error{{ else if ge (atoi .status) 400 }}warn{{ else }}info{{ end }}{{ else }}info{{ end }}"
    }

    stage.labels {
      values = {level = ""}
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://logging-loki-server:3100/loki/api/v1/push"
  }
}
